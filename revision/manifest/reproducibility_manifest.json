 "protocol": {
  "splits": "Calibration slice carved from the evaluation split with numpy default_rng(0) permutation (MedMCQA 500, MedQA 300, PubMedQA 150 items); remaining items are the test set. MedMCQA 'test' = HF validation split (official test labels are hidden). PubMedQA pqa_labeled (1000) -> 500 eval (rng 0) / 500 fine-tuning items.",
  "calibration": "Temperature fit by NLL minimization (LBFGS, lr=0.01, max_iter=200) on the calibration slice only. Temperature scaling acts on logits; MedBayes-Lite fits T on log of the MC-averaged probabilities and applies it as p^(1/T)/Z (temperature on averaged probabilities). For MedQA the *_srcT variants fit T on the MedMCQA calibration slice (true shift).",
  "fine_tuning": "PubMedQA encoders: AdamW lr 3e-5, wd 0.01, batch 16, 2 epochs, linear warm-up 6%, fp16, max_len 512; fixed schedule - no early stopping and no validation data used for model selection.",
  "thresholds": "fixed a priori (0.7 selective, 0.8 harmful); not tuned on calibration or test data; full sweep reported",
  "mc_dropout": "M=15 passes, dropout p=0.2 on all nn.Dropout modules (LayerNorm in eval), torch seed 10000+seed (test) / 11000+seed (calibration).",
  "gates": "maxprob: calibrated max probability >= tau; entropy: C(p)=1-H(p)/log K >= tau.",
  "bootstrap": "Item-level (uid) resampling, paired across methods; seeds averaged within each draw; percentile 95% CI; two-sided p with +1 correction (min p = 2/(B+1)); B=10000 for primary tests, 2000 otherwise; Holm within comparison family, BH across all.",
  "pretrained_checkpoints_note": "RUI525 MedMCQA checkpoints are third-party; their training data are reported as the MedMCQA train split (the evaluation uses the validation split)."
 },
